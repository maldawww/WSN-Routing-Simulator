<Window x:Class="SensorNetworkSimulator.ChartsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Wykresy" Height="700" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tytuł wykresu kołowego -->
        <TextBlock Grid.Row="0" Text="Stan sensorów" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

        <!-- Wykres kołowy -->
        <lvc:PieChart Grid.Row="1" Series="{Binding SensorStateSeries}" LegendLocation="Right"/>

        <!-- Tytuł wykresu słupkowego -->
        <TextBlock Grid.Row="2" Text="Poziom baterii sensorów" FontSize="16" FontWeight="Bold" Margin="0,20,0,5"/>

        <!-- Wykres słupkowy -->
        <lvc:CartesianChart Grid.Row="3"
                            Series="{Binding BatterySeries}"
                            AxisX="{Binding BatteryLabelsX}"
                            AxisY="{Binding BatteryAxisY}"/>
    </Grid>
</Window>
